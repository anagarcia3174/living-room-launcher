{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "living-room-launcher",
  "version": "0.1.0",
  "identifier": "com.ana.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Living Room Launcher",
        "width": 800,
        "height": 600,
        "fullscreen": true,
        "decorations": false,
        "resizable": false
      }
    ],
   "security": {
  "csp": null,
  "assetProtocol": {
    "enable": true,
    "scope": ["$APPCONFIG/images/*"]
  }
}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
