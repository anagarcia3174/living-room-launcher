{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Living Room Launcher",
  "version": "1.0.0",
  "identifier": "com.ana.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Living Room Launcher",
        "width": 800,
        "height": 600,
        "fullscreen": true,
        "decorations": false,
        "resizable": false
      }
    ],
 "security": {
  "csp": {
    "default-src": "'self'",
    "script-src": "'self'",
    "style-src": "'self'",
    "style-src-attr": "'unsafe-inline'",
    "img-src": "'self' asset: http://asset.localhost",
    "connect-src": "ipc: http://ipc.localhost",
    "object-src": "'none'",
    "base-uri": "'none'",
    "form-action": "'none'"
  },
  "devCsp": null,
  "assetProtocol": {
    "enable": true,
    "scope": ["$APPCONFIG/images/*"]
  }
}
  },
  "bundle": {
    "active": true,
  "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
      "windows": {
    "nsis": {
      "installMode": "currentUser"
    }
  }
  }
}
